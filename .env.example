# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Required: Claude API key for the tutor (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Optional: model for the tutor (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Optional: free messages per browser per day (default: 20)
# FREE_DAILY_LIMIT=20

# Optional: public URL once you have a custom domain (Vercel's production URL is used otherwise)
# NEXT_PUBLIC_SITE_URL=https://murba.example

# Optional: shown on the privacy page as the contact address
# NEXT_PUBLIC_CONTACT_EMAIL=

# Google AdSense. Slot IDs come from AdSense after approval. Redeploy after changing.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-4907615583667816   (already the default in src/lib/ads.ts)
# NEXT_PUBLIC_ADSENSE_SLOT_HOME=
# NEXT_PUBLIC_ADSENSE_SLOT_PHRASES=
# NEXT_PUBLIC_ADSENSE_SLOT_TUTOR=

# Optional: Google Search Console "HTML tag" verification — paste only the content="…" value
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: tip/support page (Ko-fi, Buy Me a Coffee, Stripe Payment Link). Shows a "Support MURBA" link when set.
# NEXT_PUBLIC_SUPPORT_URL=
# NEXT_PUBLIC_ADSENSE_SLOT_PLAY=
